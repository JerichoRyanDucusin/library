@model List<LoanView>
@{
    ViewData["Title"] = "Loans";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0"><i class="bi bi-arrow-left-right"></i> Loans</h1>
        <p class="text-muted mb-0">@Model.Count loans, newest first</p>
    </div>
    <a asp-action="Borrow" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Borrow a book</a>
</div>

<div class="summary-row">
    <div class="summary-tile out"><div class="num">@Model.Count(l => l.Status == "Out")</div><div class="lbl">Out</div></div>
    <div class="summary-tile overdue"><div class="num">@Model.Count(l => l.Status == "Overdue")</div><div class="lbl">Overdue</div></div>
    <div class="summary-tile returned"><div class="num">@Model.Count(l => l.Status == "Returned")</div><div class="lbl">Returned</div></div>
</div>

<div class="row g-3">
    @foreach (var loan in Model)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="loan-card @loan.Status.ToLower() p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <p class="loan-title">@loan.BookTitle</p>
                        <span class="loan-member"><i class="bi bi-person"></i> @loan.MemberName</span>
                    </div>
                    <span class="status-pill @loan.Status.ToLower()">@loan.Status</span>
                </div>
                <div class="loan-dates mb-2">
                    <div><i class="bi bi-calendar-check"></i> Loaned @(loan.LoanedOn.ToString("yyyy-MM-dd"))</div>
                    <div><i class="bi bi-calendar-event"></i> Due @(loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("yyyy-MM-dd"))</div>
                </div>
                @if (loan.ReturnedOn == null)
                {
                    <form asp-action="Return" asp-route-id="@loan.LoanId" method="post" class="text-end">
                        <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-check2-circle"></i> Return</button>
                    </form>
                }
            </div>
        </div>
    }
</div>