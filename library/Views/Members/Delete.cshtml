@model Member
@{
    ViewData["Title"] = "Delete a member";
}

<div class="form-card delete-card card mx-auto">
    <div class="card-header"><i class="bi bi-trash"></i>Delete a member</div>

    <div class="card-body p-4">
        <p class="mb-3">Are you sure you want to delete this member?</p>
        <dl class="row mb-2">
            <dt class="col-4">Name</dt>
            <dd class="col-8">@Model.name</dd>
            <dt class="col-4">Email</dt>
            <dd class="col-8">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</dd>
            <dt class="col-4">Phone</dt>
            <dd class="col-8">@(string.IsNullOrEmpty(Model.Phone) ? "—" : Model.Phone)</dd>
            <dt class="col-4">Type</dt>
            <dd class="col-8">@Model.MemberType</dd>
            <dt class="col-4">Joined</dt>
            <dd class="col-8">@Model.JoinDate</dd>
        </dl>
        <p class="text-muted small"><i class="bi bi-info-circle me-1"></i>A member who still has loans cannot be deleted.</p>

        <form asp-action="Delete" asp-route-id="@Model.MemberId" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i>Delete</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>
