@model List<Member>
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Members</h1>
        <p class="text-muted mb-0">@Model.Count members</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus"></i>Add a member</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@error</div>
}

<div class="row g-3">
    @foreach (var member in Model)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card member-card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-person-circle member-avatar"></i>
                            <div>
                                <h2 class="h5 mb-0">@member.name</h2>
                                <small class="text-muted">Member #@member.MemberId</small>
                            </div>
                        </div>
                        <span class="type-badge" data-type="@member.MemberType">@member.MemberType</span>
                    </div>
                    <ul class="list-unstyled member-details mt-3 mb-0">
                        <li><i class="bi bi-envelope"></i><span class="text-break">@(string.IsNullOrEmpty(member.Email) ? "—" : member.Email)</span></li>
                        <li><i class="bi bi-telephone"></i><span>@(string.IsNullOrEmpty(member.Phone) ? "—" : member.Phone)</span></li>
                        <li><i class="bi bi-calendar3"></i><span>Joined @member.JoinDate</span></li>
                    </ul>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@member.MemberId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</a>
                </div>
            </div>
        </div>
    }
</div>
