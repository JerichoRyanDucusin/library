@model List<Note>
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-0">Notes</h1>
        <p class="text-muted mb-0">@Model.Count notes</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i>Add a note</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">There are no notes yet. Add the first one.</div>
}

<div class="row g-3">
    @foreach (var note in Model)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card member-card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-1"><i class="bi bi-journal-text me-1"></i>@note.Title</h2>
                    <p class="text-muted small mb-3"><i class="bi bi-calendar3 me-1"></i>@note.CreatedOn.ToString("yyyy-MM-dd")</p>
                    <p class="mb-0 text-break" style="white-space: pre-line">@(string.IsNullOrWhiteSpace(note.Body) ? "No details." : note.Body)</p>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i>Edit</a>
                    <a asp-action="Delete" asp-route-id="@note.NoteId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i>Delete</a>
                </div>
            </div>
        </div>
    }
</div>
